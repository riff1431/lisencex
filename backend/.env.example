PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/lisencex?appName=Cluster0
JWT_EXPIRES_IN=7d
ENVATO_API_TOKEN=your_envato_personal_token_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
# Comma-separated list of allowed browser origins (set in production!).
# CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ── Security ──
# Rotate these — the previous defaults were committed to the repo and must be
# considered public. In production a missing/leaked value now falls back to a
# random per-boot secret (sessions reset) instead of the known default.
JWT_SECRET=change_me_strong_random_value
ACTIVATION_SECRET=change_me_strong_random_value
# Dedicated key for encrypting storage provider credentials in DB.
# IMPORTANT: set this to the SAME value in every environment that shares the
# database (e.g. local dev + Dokploy pointing at the same Atlas cluster).
# Credentials are AES-256-GCM encrypted with this key — if it differs from
# the key used when they were saved, boot logs "Failed to decrypt storage
# credential" and the providers start with empty secrets. After changing it,
# re-save provider credentials once in the admin UI (old ciphertext is not
# recoverable). Never rotate it afterwards.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STORAGE_ENCRYPTION_SECRET=change_me_strong_random_value
# Dedicated HMAC key for signed package download tokens (falls back to
# ACTIVATION_SECRET). Rotating it invalidates outstanding download links only.
# DOWNLOAD_TOKEN_SECRET=change_me_strong_random_value

# ── Payment gateways ──
# Secret for the simulator webhook HMAC (required in production).
PAYMENT_SIMULATOR_SECRET=change_me_strong_random_value
# Stripe (production webhook verification + checkout require both).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PayPal (production webhook verification requires all three).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_ENV=sandbox

# ── MinIO Object Storage (optional; also configurable via admin UI) ──
# Used to auto-seed/auto-fill the MinIO storage provider config on boot.
MINIO_ENDPOINT=https://your-minio-domain.com
MINIO_ACCESS_KEY_ID=your_minio_access_key
MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
MINIO_BUCKET=marketplace
# MINIO_REGION=us-east-1

# Master switch for payment dev-bypasses (simulator gateway, *_bypass_signature
# webhook test signatures, sandbox auto-accept). Fail-closed: ignored in
# production; must be explicitly '1' for dev/test deployments.
PAYMENTS_ALLOW_SIMULATION=0
